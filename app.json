{
  "expo": {
    "name": "SB EDU",
    "slug": "sb-edu",
    "version": "1.0.0",
    "orientation": "default",
    "scheme": "onspaceapp",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.sbedu.app",
      "versionCode": 1,
      "permissions": ["android.permission.INTERNET"],
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B1120"
        }
      ],
      "expo-web-browser",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
